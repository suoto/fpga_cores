[tasks]
bmc
cover

[options]
bmc:   mode bmc
cover: mode cover
depth 12

[engines]
# boolector avoids a z3 "unknown constant" smt2 quirk on the RAM memories and is
# faster for BMC; yices also works. Swap to `smtbmc z3` if boolector is absent.
smtbmc yices

[script]
# The DUT is pre-lowered to Verilog-2005 by sv2v (see run_formal.sh stage 1), so
# yosys' native frontend reads it plainly. The formal wrapper stays SystemVerilog
# and is read with -sv -formal so its temporal SVA (|->, |=>, $stable, ...) is
# turned into formal cells -- sv2v/yosys-slang don't support temporal SVA, hence
# the wrapper bypasses sv2v. Files are copied in via [files] below (by basename).
read_verilog dut.v
read_verilog -sv -formal axi_stream_fifo_formal.sv
prep -top axi_stream_fifo_formal

[files]
build/dut.v
axi_stream_fifo_formal.sv
