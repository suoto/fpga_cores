{
  "sources": [
    [ "src/*.vhd", { "library": "fpga_cores" } ],
    [ "formal/*.vhd", { "library": "fpga_cores_formal" } ],
    [
      "sim/*.vhd",
      {
        "library": "fpga_cores_sim"
      }
    ],
    "dependencies/**/*.vhd",
    [
      "testbench/*.vhd",
      {
        "library": "tb"
      }
    ]
  ],
  "vhdl": {
    "flags": {
      "global": [
        "-2008"
      ]
    }
  }
}
